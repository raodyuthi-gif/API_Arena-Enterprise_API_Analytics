# ──────────────────────────────────────────────
# Enterprise API Analytics Platform – Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# ──────────────────────────────────────────────

# ── Application ──
APP_NAME="Enterprise API Analytics Platform"
APP_ENV=development          # development | staging | production
APP_PORT=8000
DEBUG=true
SECRET_KEY=change-me-to-a-very-long-random-secret-key-256bits

# ── Database (PostgreSQL) ──
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/api_analytics
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── JWT Auth ──
JWT_SECRET_KEY=change-me-jwt-secret-256bit
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── ML / Forecasting ──
FORECAST_MODEL_DIR=app/ml/models
FORECAST_RETRAIN_INTERVAL_HOURS=24
FORECAST_HORIZON_HOURS=168        # 7 days

# ── CORS ──
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Rate Limiting ──
RATE_LIMIT_PER_MINUTE=120

# ── Alerting (optional) ──
SLACK_WEBHOOK_URL=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Monitoring ──
PROMETHEUS_ENABLED=true
GRAFANA_ADMIN_PASSWORD=admin

# ── Docker / K8s image ──
DOCKER_REGISTRY=ghcr.io
DOCKER_IMAGE_NAME=your-org/enterprise-api-analytics
